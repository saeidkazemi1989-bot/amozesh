# Membership server. Copy to .env and set a long random SETUP_TOKEN before first run.
PORT=3001
DB_PATH=./data/ghadam.sqlite
SETUP_TOKEN=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API (the Android app uses bearer tokens).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
# Optional at APK build time; learners can also enter the server address in the app.
VITE_API_URL=
