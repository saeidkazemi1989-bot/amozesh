import { lessons } from '../server/content/curriculum.ts';
import { levels } from '../src/data/catalog.ts';
import { mkdirSync, writeFileSync } from 'node:fs';

const template = `// Ghadam free membership backend for Google Apps Script.
// Generated by scripts/generate-apps-script.mts. Paste this whole file into Extensions > Apps Script.
const LEVELS = __LEVELS__;
const LESSONS = __LESSONS__;
const FREE_LEVEL = 'beginner-1';
const SESSION_MS = 30 * 86400000;
const HEADERS = {
  Users: ['id','username','name','passwordHash','role','active','createdAt'],
  Sessions: ['tokenHash','userId','expiresAt','createdAt'],
  Grants: ['id','userId','levelId','startsAt','expiresAt','revokedAt','createdBy','createdAt'],
  Audit: ['id','at','actor','action','detail'],
  Config: ['key','value']
};

function setup() {
  const props = PropertiesService.getScriptProperties();
  let ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss && props.getProperty('SPREADSHEET_ID')) {
    try { ss = SpreadsheetApp.openById(props.getProperty('SPREADSHEET_ID')); } catch (err) { ss = null; }
  }
  if (!ss) ss = SpreadsheetApp.create('عضویت قدم');
  props.setProperty('SPREADSHEET_ID', ss.getId());
  if (!props.getProperty('SECRET')) props.setProperty('SECRET', randomToken_());
  if (!props.getProperty('SETUP_TOKEN')) props.setProperty('SETUP_TOKEN', randomToken_());
  Object.keys(HEADERS).forEach(function (name) {
    let sheet = ss.getSheetByName(name);
    if (!sheet) sheet = ss.insertSheet(name);
    if (sheet.getLastRow() === 0) sheet.appendRow(HEADERS[name]);
    sheet.setFrozenRows(1);
  });
  const config = ss.getSheetByName('Config');
  config.getRange('A2:B2').setValues([['SETUP_TOKEN', props.getProperty('SETUP_TOKEN')]]);
  config.getRange('A3:B3').setValues([['راهنما', 'این فایل را خصوصی نگه دارید. لینک Web App را در اپ قدم وارد کنید.']]);
  Logger.log('SPREADSHEET_URL=' + ss.getUrl());
  Logger.log('SETUP_TOKEN=' + props.getProperty('SETUP_TOKEN'));
  return 'آماده است. لینک Sheet و کد راه‌اندازی در لاگ اجرای setup دیده می‌شود.';
}

function doGet(e) { return handle_({ path: (e && e.parameter && e.parameter.path) || '/health', method: 'GET' }); }
function doPost(e) {
  try {
    const input = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    return handle_(input);
  } catch (err) {
    return json_({ status: 400, data: { error: 'درخواست معتبر نیست.' } });
  }
}
function handle_(input) {
  try {
    const path = String(input.path || '/health');
    const method = String(input.method || 'GET').toUpperCase();
    const body = input.body || {};
    const token = input.token ? String(input.token) : '';
    const result = route_(path, method, body, token);
    return json_({ status: result.status || 200, data: result.data });
  } catch (err) {
    const status = err && err.httpStatus ? err.httpStatus : 500;
    return json_({ status: status, data: { error: status === 500 ? 'خطای سرور؛ کمی بعد دوباره تلاش کن.' : String(err.message || err) } });
  }
}
function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function fail_(status, message) { const err = new Error(message); err.httpStatus = status; throw err; }
function props_() { return PropertiesService.getScriptProperties(); }
function ss_() {
  const id = props_().getProperty('SPREADSHEET_ID');
  if (id) return SpreadsheetApp.openById(id);
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active) return active;
  fail_(500, 'اول تابع setup را یک بار اجرا کن تا فایل عضویت ساخته شود.');
}
function rows_(name) {
  const sheet = ss_().getSheetByName(name);
  if (!sheet || sheet.getLastRow() < 2) return [];
  const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, HEADERS[name].length).getValues();
  return values.map(function (row, i) {
    const obj = { _row: i + 2 };
    HEADERS[name].forEach(function (key, j) { obj[key] = row[j]; });
    return obj;
  });
}
function append_(name, obj) {
  const sheet = ss_().getSheetByName(name);
  sheet.appendRow(HEADERS[name].map(function (key) { return obj[key] === undefined || obj[key] === null ? '' : obj[key]; }));
}
function update_(name, row, obj) {
  const sheet = ss_().getSheetByName(name);
  const current = rows_(name).find(function (r) { return r._row === row; }) || {};
  const merged = Object.assign({}, current, obj);
  sheet.getRange(row, 1, 1, HEADERS[name].length).setValues([HEADERS[name].map(function (key) { return merged[key] === undefined || merged[key] === null ? '' : merged[key]; })]);
}
function remove_(name, row) { ss_().getSheetByName(name).deleteRow(row); }
function lock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try { return fn(); } finally { lock.releaseLock(); }
}
function randomToken_() { return (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, ''); }
function sha256_(value) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, value, Utilities.Charset.UTF_8);
  return bytes.map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
}
function hashPassword_(password) {
  const salt = randomToken_();
  let value = salt + ':' + password + ':' + (props_().getProperty('SECRET') || '');
  for (let i = 0; i < 5000; i++) value = sha256_(value);
  return salt + ':' + value;
}
function verifyPassword_(password, stored) {
  const parts = String(stored || '').split(':');
  if (parts.length !== 2) return false;
  let value = parts[0] + ':' + password + ':' + (props_().getProperty('SECRET') || '');
  for (let i = 0; i < 5000; i++) value = sha256_(value);
  return value === parts[1];
}
function tokenHash_(token) { return sha256_(token + ':' + (props_().getProperty('SECRET') || '')); }
function validUsername_(v) { return typeof v === 'string' && /^[a-zA-Z0-9._-]{3,40}$/.test(v); }
function validName_(v) { return typeof v === 'string' && v.trim().length > 0 && v.trim().length <= 60; }
function validPassword_(v) { return typeof v === 'string' && v.length >= 10 && v.length <= 128; }
function publicUser_(u) { return { id: u.id, username: u.username, name: u.name, role: u.role }; }
function sessionUser_(token) {
  if (!token) return null;
  const hash = tokenHash_(token);
  const now = Date.now();
  const session = rows_('Sessions').find(function (s) { return s.tokenHash === hash && Number(s.expiresAt) > now; });
  if (!session) return null;
  const user = rows_('Users').find(function (u) { return u.id === session.userId && (u.active === true || u.active === 'TRUE' || u.active === 1); });
  return user || null;
}
function createSession_(userId) {
  const token = randomToken_();
  append_('Sessions', { tokenHash: tokenHash_(token), userId: userId, expiresAt: Date.now() + SESSION_MS, createdAt: new Date().toISOString() });
  return token;
}
function deleteSession_(token) {
  if (!token) return;
  const hash = tokenHash_(token);
  rows_('Sessions').filter(function (s) { return s.tokenHash === hash; }).reverse().forEach(function (s) { remove_('Sessions', s._row); });
}
function deleteUserSessions_(userId) {
  rows_('Sessions').filter(function (s) { return s.userId === userId; }).reverse().forEach(function (s) { remove_('Sessions', s._row); });
}
function audit_(actor, action, detail) {
  append_('Audit', { id: randomToken_(), at: new Date().toISOString(), actor: actor, action: action, detail: JSON.stringify(detail || {}) });
}
function rateLimit_(key, limit, seconds) {
  const cache = CacheService.getScriptCache();
  const current = Number(cache.get(key) || 0);
  if (current >= limit) fail_(429, 'تلاش‌های زیاد؛ کمی بعد دوباره امتحان کن.');
  cache.put(key, String(current + 1), seconds);
}
function activeGrants_(userId, now) {
  now = now || Date.now();
  return rows_('Grants').filter(function (g) { return g.userId === userId && !g.revokedAt && Number(g.startsAt) <= now && Number(g.expiresAt) > now; });
}
function activeLevelIds_(user, now) {
  if (user.role === 'admin') return LEVELS.map(function (l) { return l.id; });
  const ids = [FREE_LEVEL].concat(activeGrants_(user.id, now).map(function (g) { return g.levelId; }));
  return ids.filter(function (id, i) { return ids.indexOf(id) === i; });
}
function addMonthsClamped_(start, months) {
  const date = new Date(start);
  const day = date.getUTCDate();
  date.setUTCDate(1); date.setUTCMonth(date.getUTCMonth() + months);
  const last = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + 1, 0)).getUTCDate();
  date.setUTCDate(Math.min(day, last));
  return date.getTime();
}
function grantJson_(g) { return { id: g.id, levelId: g.levelId, startsAt: Number(g.startsAt), expiresAt: Number(g.expiresAt), revokedAt: g.revokedAt ? Number(g.revokedAt) : null }; }
function requireUser_(token) { const user = sessionUser_(token); if (!user) fail_(401, 'وارد حساب کاربری شو.'); return user; }
function requireAdmin_(token) { const user = requireUser_(token); if (user.role !== 'admin') fail_(403, 'این بخش فقط برای مدیر است.'); return user; }

function route_(path, method, body, token) {
  if (path === '/health' && method === 'GET') return { data: { ok: true, service: 'ghadam-membership-apps-script' } };
  if (path === '/catalog' && method === 'GET') return { data: { levels: LEVELS, lessons: LESSONS.map(function (l) { return { id: l.id, title: l.title, subtitle: l.subtitle, icon: l.icon, color: l.color, levelId: l.levelId, phraseIds: l.phrases.map(function (p) { return p.id; }) }; }), freeLevel: FREE_LEVEL } };
  if (path === '/setup-status' && method === 'GET') return { data: { needsSetup: !rows_('Users').some(function (u) { return u.role === 'admin'; }) } };
  if (path === '/setup' && method === 'POST') return lock_(function () {
    rateLimit_('setup', 20, 900);
    if (rows_('Users').some(function (u) { return u.role === 'admin'; })) fail_(409, 'حساب مدیر قبلاً ساخته شده است.');
    if (!props_().getProperty('SETUP_TOKEN') || body.setupToken !== props_().getProperty('SETUP_TOKEN')) fail_(403, 'کد راه‌اندازی درست نیست.');
    if (!validUsername_(body.username) || !validName_(body.name) || !validPassword_(body.password)) fail_(400, 'نام کاربری انگلیسی ۳ تا ۴۰ نویسه، نام نمایشی و رمز حداقل ۱۰ نویسه لازم است.');
    const id = Utilities.getUuid();
    append_('Users', { id: id, username: body.username, name: body.name.trim(), passwordHash: hashPassword_(body.password), role: 'admin', active: true, createdAt: new Date().toISOString() });
    audit_(body.username, 'setup', {});
    const session = createSession_(id);
    return { status: 201, data: { user: publicUser_(rows_('Users').find(function (u) { return u.id === id; })), token: session } };
  });
  if (path === '/auth/login' && method === 'POST') return lock_(function () {
    rateLimit_('login:' + String(body.username || '').slice(0, 80), 20, 900);
    const user = rows_('Users').find(function (u) { return u.username === body.username; });
    if (!user || !(user.active === true || user.active === 'TRUE' || user.active === 1) || !verifyPassword_(String(body.password || ''), user.passwordHash)) fail_(401, 'نام کاربری یا رمز درست نیست، یا حساب غیرفعال است.');
    const session = createSession_(user.id);
    return { data: { user: publicUser_(user), token: session } };
  });
  if (path === '/auth/logout' && method === 'POST') return lock_(function () { requireUser_(token); deleteSession_(token); return { data: { ok: true } }; });
  if (path === '/auth/password' && method === 'POST') return lock_(function () {
    const user = requireUser_(token);
    rateLimit_('password:' + user.id, 20, 900);
    if (!verifyPassword_(String(body.currentPassword || ''), user.passwordHash) || !validPassword_(body.newPassword)) fail_(400, 'رمز فعلی یا رمز تازه معتبر نیست؛ رمز تازه حداقل ۱۰ نویسه باشد.');
    update_('Users', user._row, { passwordHash: hashPassword_(body.newPassword) });
    deleteUserSessions_(user.id);
    audit_(user.username, 'password.change', {});
    return { data: { ok: true, token: createSession_(user.id) } };
  });
  if (path === '/me' && method === 'GET') {
    const user = requireUser_(token);
    return { data: { user: publicUser_(user), serverTime: Date.now(), freeLevel: FREE_LEVEL, levels: activeLevelIds_(user), grants: activeGrants_(user.id).map(grantJson_) } };
  }
  if (path === '/content' && method === 'GET') {
    const user = requireUser_(token);
    const allowed = activeLevelIds_(user);
    return { data: { serverTime: Date.now(), levels: allowed, lessons: LESSONS.filter(function (l) { return allowed.indexOf(l.levelId) !== -1; }) } };
  }
  if (path.indexOf('/access/') === 0 && method === 'GET') {
    const user = requireUser_(token);
    const lessonId = path.slice('/access/'.length);
    const lesson = LESSONS.find(function (l) { return l.id === lessonId; });
    if (!lesson) fail_(404, 'درس پیدا نشد.');
    return { data: { allowed: activeLevelIds_(user).indexOf(lesson.levelId) !== -1, levelId: lesson.levelId, serverTime: Date.now() } };
  }
  if (path === '/admin/members' && method === 'GET') {
    requireAdmin_(token);
    const grants = rows_('Grants');
    const members = rows_('Users').filter(function (u) { return u.role === 'member'; }).sort(function (a, b) { return String(b.createdAt).localeCompare(String(a.createdAt)); }).map(function (u) {
      return { id: u.id, username: u.username, name: u.name, active: u.active === true || u.active === 'TRUE' || u.active === 1, createdAt: u.createdAt, grants: grants.filter(function (g) { return g.userId === u.id; }).map(grantJson_) };
    });
    return { data: { members: members, levels: LEVELS } };
  }
  if (path === '/admin/members' && method === 'POST') return lock_(function () {
    const admin = requireAdmin_(token);
    if (!validUsername_(body.username) || !validName_(body.name) || !validPassword_(body.password)) fail_(400, 'نام کاربری انگلیسی ۳ تا ۴۰ نویسه، نام نمایشی و رمز حداقل ۱۰ نویسه لازم است.');
    if (rows_('Users').some(function (u) { return u.username === body.username; })) fail_(409, 'این نام کاربری قبلاً استفاده شده است.');
    const id = Utilities.getUuid();
    append_('Users', { id: id, username: body.username, name: body.name.trim(), passwordHash: hashPassword_(body.password), role: 'member', active: true, createdAt: new Date().toISOString() });
    audit_(admin.username, 'member.create', { id: id, username: body.username });
    return { status: 201, data: { id: id, username: body.username, name: body.name.trim() } };
  });
  if (path.indexOf('/admin/members/') === 0 && path.indexOf('/grants') === -1 && method === 'PATCH') return lock_(function () {
    const admin = requireAdmin_(token);
    const id = path.slice('/admin/members/'.length);
    const target = rows_('Users').find(function (u) { return u.id === id && u.role === 'member'; });
    if (!target) fail_(404, 'عضو پیدا نشد.');
    const changes = {};
    if (body.name !== undefined) { if (!validName_(body.name)) fail_(400, 'نام معتبر نیست.'); changes.name = body.name.trim(); }
    if (body.active !== undefined) { if (typeof body.active !== 'boolean') fail_(400, 'وضعیت معتبر نیست.'); changes.active = body.active; }
    if (body.password !== undefined) { if (!validPassword_(body.password)) fail_(400, 'رمز تازه حداقل ۱۰ نویسه باشد.'); changes.passwordHash = hashPassword_(body.password); }
    update_('Users', target._row, changes);
    if (body.password !== undefined || body.active === false) deleteUserSessions_(target.id);
    audit_(admin.username, 'member.update', { id: target.id, name: body.name, active: body.active, passwordReset: body.password !== undefined });
    return { data: { ok: true } };
  });
  if (path.indexOf('/admin/members/') === 0 && path.indexOf('/grants') !== -1 && method === 'POST') return lock_(function () {
    const admin = requireAdmin_(token);
    const id = path.slice('/admin/members/'.length, path.indexOf('/grants'));
    const target = rows_('Users').find(function (u) { return u.id === id && u.role === 'member'; });
    if (!target) fail_(404, 'عضو پیدا نشد.');
    const months = Number(body.months);
    if (!LEVELS.some(function (l) { return l.id === body.levelId; }) || !Number.isInteger(months) || months < 1 || months > 36) fail_(400, 'سطح و مدت ۱ تا ۳۶ ماه را انتخاب کن.');
    const now = Date.now();
    const current = activeGrants_(target.id, now).find(function (g) { return g.levelId === body.levelId; });
    const startsAt = current ? Number(current.startsAt) : now;
    const base = current ? Math.max(now, Number(current.expiresAt)) : now;
    const expiresAt = addMonthsClamped_(base, months);
    let grantId;
    if (current) { grantId = current.id; update_('Grants', current._row, { expiresAt: expiresAt }); }
    else { grantId = Utilities.getUuid(); append_('Grants', { id: grantId, userId: target.id, levelId: body.levelId, startsAt: startsAt, expiresAt: expiresAt, revokedAt: '', createdBy: admin.username, createdAt: new Date().toISOString() }); }
    audit_(admin.username, current ? 'grant.extend' : 'grant.create', { memberId: target.id, levelId: body.levelId, months: months, expiresAt: expiresAt });
    return { status: 201, data: { id: grantId, levelId: body.levelId, startsAt: startsAt, expiresAt: expiresAt } };
  });
  if (path.indexOf('/admin/grants/') === 0 && method === 'DELETE') return lock_(function () {
    const admin = requireAdmin_(token);
    const id = path.slice('/admin/grants/'.length);
    const grant = rows_('Grants').find(function (g) { return g.id === id && !g.revokedAt; });
    if (!grant) fail_(404, 'دسترسی پیدا نشد.');
    update_('Grants', grant._row, { revokedAt: Date.now() });
    audit_(admin.username, 'grant.revoke', { id: grant.id, userId: grant.userId, levelId: grant.levelId });
    return { data: { ok: true } };
  });
  if (path === '/admin/audit' && method === 'GET') {
    requireAdmin_(token);
    return { data: { entries: rows_('Audit').sort(function (a, b) { return String(b.at).localeCompare(String(a.at)); }).slice(0, 100) } };
  }
  fail_(404, 'این مسیر وجود ندارد.');
}
`;

mkdirSync('google-apps-script', { recursive: true });
const code = template.replace('__LEVELS__', JSON.stringify(levels)).replace('__LESSONS__', JSON.stringify(lessons));
writeFileSync('google-apps-script/Code.gs', code);
console.log(`Generated google-apps-script/Code.gs with ${levels.length} levels and ${lessons.length} lessons.`);
