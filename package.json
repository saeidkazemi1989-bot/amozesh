{
  "name": "ghadam-language-learning",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run generate:catalog && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/lib/*.test.ts server/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "node tests/production.mjs",
    "package:mobile": "node scripts/package-mobile.mjs",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "test:api": "tsx --test server/*.test.ts",
    "generate:catalog": "tsx scripts/generate-catalog.mts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "generate:apps-script": "tsx scripts/generate-apps-script.mts",
    "test:apps-script": "node scripts/test-apps-script.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
